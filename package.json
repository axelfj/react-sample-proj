{
  "name": "the-real-reactivation",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://axelfj.github.io/the-real-reactivation/",
  "dependencies": {
    "@material-ui/core": "^4.11.3",
    "axios": "^1.20.0",
    "formik": "^2.2.6",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.2.0",
    "styled-components": "^5.2.3",
    "web-vitals": "^1.1.1",
    "yup": "^0.32.9",
    "react-bootstrap": "^1.6.8"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^17.0.89",
    "@types/react-dom": "^17.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.36",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0",
    "vitest": "^5.0.5",
    "jsdom": "^28.0.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "storybook": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "gh-pages": "^6.3.0"
  }
}
